{
  "name": "02 - Camera Behavior - Setup Agent",
  "nodes": [
    {
      "parameters": {
        "content": "# Setup Agent\n- Input: user goal summary, building context, optional role/constraints/prior summary\n- Output: `study_plan`, `task_graph`, `graph_plan`, `needfinding_request`, `behavior_monitoring_request_template`, `actionable_insights_request`\n- This workflow plans only, then hands the package to the Study Orchestrator.\n\n# Test Case\n{ \"study_goal\": \"Find congestion in the east lobby\", \"space_type\": \"office lobby\", \"target_area\": \"east lobby\", \"study_duration\": \"2 weeks\", \"desired_output_type\": \"hotspot charts and recommendations\", \"building_id\": \"bldg_001\" }\n\n# Study-State Model\n- draft -> planned -> needfinding_running -> needfinding_complete -> monitoring_running -> milestone_review -> monitoring_complete -> insights_running -> complete\n- failed is terminal unless manually retried.",
        "width": 780,
        "height": 320,
        "color": 4
      },
      "id": "sticky-0043",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -40
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger-0044",
      "name": "When Executed by Chat",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $json.setup_request ? { ...$json.setup_request, source_payload: $json } : $json;\nconst studyId = $json.study_id ?? ('study_' + Date.now());\nreturn [{\n  json: {\n    study_id: studyId,\n    user_goal: input.study_goal ?? $json.user_goal_summary ?? '',\n    building_context: {\n      building_id: input.building_id ?? $json.building_id ?? null,\n      space_type: input.space_type ?? null,\n      target_area: input.target_area ?? null\n    },\n    desired_output_type: input.desired_output_type ?? null,\n    study_duration: input.study_duration ?? '2 weeks',\n    user_role: $json.user_role ?? null,\n    constraints: $json.constraints ?? null,\n    prior_conversation_summary: $json.prior_conversation_summary ?? null,\n    debug_mode: $json.debug_mode ?? false,\n    source_payload: $json,\n  }\n}];\n"
      },
      "id": "code-0045",
      "name": "Normalize Setup Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json, null, 2) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are the study planner.\nYour job is to convert the user goal into a structured study plan and explicit downstream task definitions.\nYou are responsible for planning, not long-term execution control.\nDo not analyze images.\nDo not monitor study progress.\nDo not communicate directly with specialist agents during execution.\nReturn JSON only.\n\nPlanning rules:\n- Define concrete study objectives and study questions.\n- Propose planning-stage behavior categories only; final behavior targets are produced by needfinding.\n- Produce downstream request templates, not final execution payloads.\n- Include milestone-friendly dashboard outputs.\n- Keep the behavior monitoring request template image-safe and tool-safe for later orchestration."
            }
          ]
        }
      },
      "id": "llm-0048",
      "name": "Study Planner",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        760,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "model-0046",
      "name": "Setup Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        760,
        520
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"study_plan\": {\n    \"study_id\": \"string\",\n    \"study_goal\": \"string\",\n    \"study_objectives\": [\"string\"],\n    \"study_questions\": [\"string\"],\n    \"building_context\": {\n      \"building_id\": \"string|null\",\n      \"space_type\": \"string|null\",\n      \"target_area\": \"string|null\"\n    },\n    \"study_duration\": \"string\",\n    \"success_criteria\": [\"string\"],\n    \"output_mode\": \"dashboard_json\",\n    \"completion_criteria\": {\n      \"study_end_rule\": \"string\",\n      \"minimum_dataset_rule\": \"string\"\n    }\n  },\n  \"task_graph\": {\n    \"nodes\": [\n      {\n        \"task_id\": \"string\",\n        \"task_name\": \"string\",\n        \"depends_on\": [\"string\"],\n        \"workflow\": \"needfinding|monitoring|insights|aggregation\"\n      }\n    ]\n  },\n  \"graph_plan\": {\n    \"dashboard_sections\": [\"string\"],\n    \"charts\": [\"string\"],\n    \"tables\": [\"string\"]\n  },\n  \"needfinding_request\": {\n    \"user_goal\": \"string\",\n    \"building_context\": \"string\",\n    \"study_questions\": [\"string\"],\n    \"desired_outcome\": \"string\",\n    \"setup_instructions\": \"string\"\n  },\n  \"behavior_monitoring_request_template\": {\n    \"study_id\": \"string\",\n    \"building_id\": \"string|null\",\n    \"zone_ids\": [\"string\"],\n    \"date_range\": {\n      \"start\": \"string\",\n      \"end\": \"string\"\n    },\n    \"image_selection_rules\": {\n      \"human_detected_only\": true,\n      \"dedupe_window_minutes\": 5\n    },\n    \"setup_instructions\": \"string\"\n  },\n  \"actionable_insights_request\": {\n    \"output_mode\": \"milestone_summary|final_insights\",\n    \"instructions\": \"string\"\n  }\n}"
      },
      "id": "parser-0047",
      "name": "Setup Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1000,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst output = item.output ?? item.text ?? item.response ?? item.data ?? item;\nlet parsed = output;\nconst errors = [];\nif (typeof parsed === 'string') {\n  try {\n    parsed = JSON.parse(parsed);\n  } catch (error) {\n    errors.push('json_parse_failed');\n  }\n}\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n  errors.push('payload_not_object');\n  parsed = {};\n}\nfor (const field of [\"study_plan\",\"task_graph\",\"graph_plan\",\"needfinding_request\",\"behavior_monitoring_request_template\",\"actionable_insights_request\"]) {\n  if (!(field in parsed)) errors.push(`missing_${field}`);\n}\nreturn [{\n  json: {\n    raw_ai_output: output,\n    parsed_output: parsed,\n    validation_passed: errors.length === 0,\n    validation_errors: errors,\n  }\n}];\n"
      },
      "id": "code-0049",
      "name": "Validate Setup JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-0050",
              "leftValue": "={{ $json.validation_passed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
