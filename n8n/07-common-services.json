    {
      "parameters": {
        "jsCode": "\nreturn [{\n  json: {\n    operation: $('Normalize Service Operation').item.json.operation,\n    status: 'ok',\n    completed_at: new Date().toISOString()\n  }\n}];\n"
      },
      "id": "code-0135",
      "name": "Build Service Response",
      "type": "n8n-nodes-base.code",
