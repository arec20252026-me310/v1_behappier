        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n    study_id: $json.study_id ?? null,\n    workflow_name: $json.workflow_name ?? 'unknown',\n    node_name: $json.node_name ?? 'unknown',\n    timestamp: new Date().toISOString(),\n    input_reference: $json.input_reference ?? null,\n    error_message: $json.error_message ?? 'unknown_error',\n    retry_count: $json.retry_count ?? 0\n  }) }}",
        "options": {}
      },
      "id": "http-0134",
      "name": "Store Workflow Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        520
      ],
      "retryOnFail": true,
      "maxTries": 3,
