      "typeVersion": 1.1,
      "position": [
        0,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "\nreturn [{\n  json: {\n    needfinding_prompt: JSON.stringify($json, null, 2),\n    source_payload: $json\n  }\n}];\n"
      },
      "id": "d12f6929-1c57-4d16-98ae-a7e0c465b663",
      "name": "Prepare Needfinding Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        320
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.needfinding_prompt }}",
        "options": {
          "systemMessage": "You are the literature-grounded behavior relevance specialist.\nGiven the study goal and building context, identify which occupant behaviors matter and how they relate to building conditions and study objectives.\nYou do not analyze images.\nYou do not communicate directly with the Behavior Monitoring Agent or the Actionable Insights Agent.\nYour outputs are returned to the Study Orchestrator only.\nAlways search before answering.\nReturn JSON only with:\n- needfinding_summary\n- behavior_targets\n- evidence_notes\n- building_relevance_notes\n\nEach behavior target must include:\n- behavior_name\n- why_it_matters\n- likely_building_interpretation\n- confidence\n- evidence_summary\n- detection_hint_for_vision_agent",
          "returnIntermediateSteps": true
        }
      },
      "id": "0bf716bb-ac62-497f-b970-32b1638af3a4",
      "name": "Needfinding Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        528,
        320
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "05679660-44c4-4b4b-8af0-7aee2c5ead24",
      "name": "Needfinding Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        528,
        560
      ],
      "credentials": {
        "openAiApi": {
          "id": "kZpqcM3SJ8maViAy",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "Search authoritative web and literature sources about occupant behavior, congestion, utilization, collaboration, thermal comfort proxies, and building performance. Use this before finalizing behavior targets.",
        "method": "POST",
        "url": "={{ $vars.RESEARCH_SEARCH_URL || 'https://api.tavily.com/search' }}",
        "sendHeaders": true,
        "parametersHeaders": {
          "values": [
            {}
          ]
        },
        "sendBody": true,
        "parametersBody": {
          "values": [
            {
              "name": "query"
            },
            {
              "name": "search_depth",
              "valueProvider": "fieldValue",
              "value": "advanced"
            },
            {
              "name": "max_results",
              "valueProvider": "fieldValue",
              "value": "5"
            },
            {
              "name": "include_raw_content",
              "valueProvider": "fieldValue",
              "value": "true"
            },
            {
              "name": "include_domains",
              "valueProvider": "fieldValue",
              "value": "=[\"ashrae.org\",\"cbe.berkeley.edu\",\"nih.gov\",\"nature.com\",\"sciencedirect.com\",\"mdpi.com\"]"
            }
          ]
        },
        "optimizeResponse": true,
        "dataField": "results"
      },
      "id": "7785656f-ea55-4b3c-b1ad-80e0fd4dc12b",
      "name": "Literature Search Tool",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        768,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst output = item.output ?? item.text ?? item.response ?? item.data ?? item;\nlet parsed = output;\nconst errors = [];\nif (typeof parsed === 'string') {\n  try {\n    parsed = JSON.parse(parsed);\n  } catch (error) {\n    errors.push('json_parse_failed');\n  }\n}\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n  errors.push('payload_not_object');\n  parsed = {};\n}\nfor (const field of [\"needfinding_summary\",\"behavior_targets\",\"evidence_notes\",\"building_relevance_notes\"]) {\n  if (!(field in parsed)) errors.push(`missing_${field}`);\n}\nreturn [{\n  json: {\n    raw_ai_output: output,\n    parsed_output: parsed,\n    validation_passed: errors.length === 0,\n    validation_errors: errors,\n  }\n}];\n"
      },
