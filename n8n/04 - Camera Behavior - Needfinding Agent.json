{
  "name": "04 - Camera Behavior - Needfinding Agent",
  "nodes": [
    {
      "parameters": {
        "content": "# Needfinding Agent\n- Uses a tool-capable AI agent for literature/web search.\n- Returns only structured behavior targets and evidence.\n- Never analyzes images.\n\n# Test Case\n{ \"user_goal\": \"Find congestion issues in an office lobby\", \"building_context\": \"office lobby with entry turnstiles\", \"study_questions\": [\"Where does crowding occur?\", \"When are peak surges?\"], \"desired_outcome\": \"behavior targets for vision monitoring\" }",
