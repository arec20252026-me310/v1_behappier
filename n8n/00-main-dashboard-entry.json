{
  "name": "00 - Camera Behavior - Main Dashboard Entry",
  "nodes": [
    {
      "parameters": {
        "content": "# Thin Main Workflow\n- This is the workflow your website should call.\n- It keeps the canvas small by delegating to the imported Chat Entry workflow.\n- The Chat Entry workflow then delegates to Setup, and Setup delegates to the Orchestrator.\n\n# Important n8n Wiring\n- n8n does not call JSON files directly after import.\n- Open `Call Chat Entry Sub-workflow` and select the imported `01 - Camera Behavior - Chat Entry` workflow.\n- If you prefer environment variables, set `WF_CHAT_ENTRY_ID` to the imported workflow ID.\n\n# Test Payload\n{ \"user_id\": \"user_001\", \"session_id\": \"session_001\", \"message_text\": \"Start a 2 week congestion study in the east lobby with hotspot charts\", \"building_id\": \"bldg_001\" }",
        "width": 820,
        "height": 340,
        "color": 6
      },
      "id": "sticky-0036",
      "name": "Main Entry Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -60
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "occupant-behavior-main",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-0037",
      "name": "Website Dashboard Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "webhookId": "hook-0038",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $json.body ?? $json;\nreturn [{\n  json: {\n    user_id: body.user_id ?? null,\n    session_id: body.session_id ?? null,\n    message_text: body.message_text ?? body.message ?? '',\n    building_id: body.building_id ?? null,\n    study_id: body.study_id ?? null,\n    debug_mode: body.debug_mode ?? false,\n    source: 'website_dashboard',\n    received_at: new Date().toISOString(),\n  }\n}];\n"
      },
      "id": "code-0039",
      "name": "Normalize Dashboard Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $vars.WF_CHAT_ENTRY_ID || 'SET_WF_CHAT_ENTRY_ID' }}",
          "cachedResultName": "01 - Camera Behavior - Chat Entry"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "user_id": "={{ $json.user_id }}",
            "session_id": "={{ $json.session_id }}",
            "message_text": "={{ $json.message_text }}",
            "building_id": "={{ $json.building_id }}",
            "study_id": "={{ $json.study_id }}",
            "debug_mode": "={{ $json.debug_mode }}",
            "source": "={{ $json.source }}",
            "received_at": "={{ $json.received_at }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "ignoreTypeMismatchErrors": false
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "exec-0040",
      "name": "Call Chat Entry Sub-workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        520,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nreturn [{\n  json: {\n    assistant_response_text: $json.assistant_response_text ?? 'I could not complete that request safely.',\n    action_type: $json.action_type ?? 'clarify_request',\n    study_id: $json.study_id ?? null,\n    study_readiness_status: $json.study_readiness_status ?? null,\n    setup_request: $json.setup_request ?? null,\n    dashboard_payload: $json,\n  }\n}];\n"
      },
      "id": "code-0041",
      "name": "Return Dashboard Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    }
  ],
  "connections": {
