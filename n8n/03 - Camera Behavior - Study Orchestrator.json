      "parameters": {
        "jsCode": "\nconst need = $json;\nconst original = $('Normalize Orchestration Command').item.json;\nconst monitoring = {\n  ...(original.behavior_monitoring_request_template ?? {}),\n  study_id: original.study_id,\n  behavior_targets: need.behavior_targets ?? [],\n  building_id: original.study_plan?.building_context?.building_id ?? null,\n  zone_ids: [original.study_plan?.building_context?.target_area].filter(Boolean),\n  setup_instructions: original.behavior_monitoring_request_template?.setup_instructions ?? 'Use only requested behavior targets.',\n};\nreturn [{\n  json: {\n    ...original,\n    needfinding_output: need,\n    downstream_monitoring_request: monitoring,\n  }\n}];\n"
      },
