{
  "name": "07 - Camera Behavior - Common Services",
  "nodes": [
    {
      "parameters": {
        "content": "# Common Services\n- Shared logging, error capture, and live preview aggregation.\n- Can be called directly by the orchestrator or run on a schedule.\n\n# Supported operations\n- `aggregate_preview_metrics`\n- `log_event`\n- `log_error`\n\n# Storage Tables\n- studies\n- study_tasks\n- needfinding_outputs\n- image_events\n- behavior_detections\n- insight_outputs\n- workflow_logs\n- workflow_errors",
        "height": 280,
        "width": 760,
        "color": 5
      },
      "id": "642f4076-c01e-4e3e-9f6b-6f0dc5a5842d",
      "name": "Service Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "702a2129-6ace-40c4-aa54-8a9af38aa677",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        368
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "ffa4394b-30e8-4dd3-ba1c-0944f0ddbf31",
      "name": "Preview Aggregation Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        608
      ]
    },
    {
      "parameters": {
        "jsCode": "\nif ($json.command || $json.operation) {\n  return [{ json: { ...$json, operation: $json.operation ?? $json.command } }];\n}\nreturn [{\n  json: {\n    operation: 'aggregate_preview_metrics',\n    scheduled_run: true,\n    triggered_at: new Date().toISOString()\n  }\n}];\n"
      },
      "id": "f9bda77a-75fa-41c0-8d2d-76f02adfa31b",
      "name": "Normalize Service Operation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        464
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-0126",
              "leftValue": "={{ $json.operation }}",
              "rightValue": "aggregate_preview_metrics",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1d1659d-17a7-4f5e-bb6c-fc49a5e2df2d",
