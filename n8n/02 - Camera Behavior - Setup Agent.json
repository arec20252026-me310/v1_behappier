        "jsCode": "\nconst source = $json.parsed_output ? $json : $items('Validate Setup JSON', 0, 0)[0].json;\nconst parsed = source.parsed_output ?? {};\nparsed.study_plan.study_id = $('Normalize Setup Input').item.json.study_id;\nparsed.behavior_monitoring_request_template.study_id = $('Normalize Setup Input').item.json.study_id;\nreturn [{\n  json: {\n    ...parsed,\n    debug_mode: $('Normalize Setup Input').item.json.debug_mode,\n    study_id: $('Normalize Setup Input').item.json.study_id,\n    setup_validation_errors: source.validation_errors ?? [],\n    raw_ai_output: source.raw_ai_output ?? null,\n  }\n}];\n"
