      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "c881e28c-86b2-49f0-90c7-540b2881a120",
      "name": "When Executed by Chat",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        3312,
        976
      ]
