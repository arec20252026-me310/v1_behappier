    {
      "parameters": {
        "jsCode": "\nconst input = $json.setup_request ? { ...$json.setup_request, source_payload: $json } : $json;\nconst studyId = $json.study_id ?? ('study_' + Date.now());\n// TEST OVERRIDE: Kitchen zone hardcoded for testing - replace with real zone resolution later\nconst TEST_KITCHEN_ZONE_ID = '4a1fd84a-8805-49c2-b6bc-6552519ad18b';\nreturn [{\n  json: {\n    study_id: studyId,\n    user_goal: input.study_goal ?? $json.user_goal_summary ?? '',\n    building_context: {\n      building_id: input.building_id ?? $json.building_id ?? null,\n      space_type: input.space_type ?? null,\n      target_area: input.target_area ?? TEST_KITCHEN_ZONE_ID,\n    },\n    desired_output_type: input.desired_output_type ?? null,\n    study_duration: input.study_duration ?? '2 weeks',\n    user_role: $json.user_role ?? null,\n    constraints: $json.constraints ?? null,\n    prior_conversation_summary: $json.prior_conversation_summary ?? null,\n    debug_mode: $json.debug_mode ?? false,\n    source_payload: $json,\n  }\n}];\n"
      },
      "id": "df306f88-a40f-429e-a615-44dc64ca574c",
      "name": "Normalize Setup Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3696,
        1280
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json, null, 2) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are the study planner.\nYour job is to convert the user goal into a structured study plan and explicit downstream task definitions.\nYou are responsible for planning, not long-term execution control.\nDo not analyze images.\nDo not monitor study progress.\nDo not communicate directly with specialist agents during execution.\nReturn JSON only.\n\nPlanning rules:\n- Define concrete study objectives and study questions.\n- Propose planning-stage behavior categories only; final behavior targets are produced by needfinding.\n- Produce downstream request templates, not final execution payloads.\n- Include milestone-friendly dashboard outputs.\n- Keep the behavior monitoring request template image-safe and tool-safe for later orchestration."
            }
          ]
        }
      },
      "id": "cf18085a-617b-42e5-b3c1-51a61aafc78c",
      "name": "Study Planner",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        4192,
        1280
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
