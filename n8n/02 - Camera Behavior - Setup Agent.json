    {
      "parameters": {
        "jsCode": "\nconst input = $json.setup_request ? { ...$json.setup_request, source_payload: $json } : $json;\nconst studyId = $json.study_id ?? ('study_' + Date.now());\n// TEST OVERRIDE: Kitchen zone hardcoded for testing - replace with real zone resolution later\nconst TEST_KITCHEN_ZONE_ID = '4a1fd84a-8805-49c2-b6bc-6552519ad18b';\nreturn [{\n  json: {\n    study_id: studyId,\n    user_goal: input.study_goal ?? $json.user_goal_summary ?? '',\n    building_context: {\n      building_id: input.building_id ?? $json.building_id ?? null,\n      space_type: input.space_type ?? null,\n      target_area: input.target_area ?? TEST_KITCHEN_ZONE_ID,\n    },\n    desired_output_type: input.desired_output_type ?? null,\n    study_duration: input.study_duration ?? '2 weeks',\n    user_role: $json.user_role ?? null,\n    constraints: $json.constraints ?? null,\n    prior_conversation_summary: $json.prior_conversation_summary ?? null,\n    debug_mode: $json.debug_mode ?? false,\n    source_payload: $json,\n  }\n}];\n"
      },
      "id": "bdc051a4-21e4-4551-96cc-3c59d3639089",
      "name": "Normalize Setup Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3584,
        976
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json, null, 2) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are the study planner.\nYour job is to convert the user goal into a structured study plan and explicit downstream task definitions.\nYou are responsible for planning, not long-term execution control.\nDo not analyze images.\nDo not monitor study progress.\nDo not communicate directly with specialist agents during execution.\nReturn JSON only.\n\nPlanning rules:\n- Define concrete study objectives and study questions.\n- Propose planning-stage behavior categories only; final behavior targets are produced by needfinding.\n- Produce downstream request templates, not final execution payloads.\n- Include milestone-friendly dashboard outputs.\n- Keep the behavior monitoring request template image-safe and tool-safe for later orchestration."
            }
          ]
        }
      },
      "id": "fd1078a8-169e-4a1c-a0cc-102ac13feb5d",
      "name": "Study Planner",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        4080,
        976
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "c67cc93e-75af-4e97-82fd-2ce65240d1c7",
      "name": "Setup Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        4080,
        1184
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"study_plan\": {\n    \"study_id\": \"string\",\n    \"study_goal\": \"string\",\n    \"study_objectives\": [\"string\"],\n    \"study_questions\": [\"string\"],\n    \"building_context\": {\n      \"building_id\": \"string|null\",\n      \"space_type\": \"string|null\",\n      \"target_area\": \"string|null\"\n    },\n    \"study_duration\": \"string\",\n    \"success_criteria\": [\"string\"],\n    \"output_mode\": \"dashboard_json\",\n    \"completion_criteria\": {\n      \"study_end_rule\": \"string\",\n      \"minimum_dataset_rule\": \"string\"\n    }\n  },\n  \"task_graph\": {\n    \"nodes\": [\n      {\n        \"task_id\": \"string\",\n        \"task_name\": \"string\",\n        \"depends_on\": [\"string\"],\n        \"workflow\": \"needfinding|monitoring|insights|aggregation\"\n      }\n    ]\n  },\n  \"graph_plan\": {\n    \"dashboard_sections\": [\"string\"],\n    \"charts\": [\"string\"],\n    \"tables\": [\"string\"]\n  },\n  \"needfinding_request\": {\n    \"user_goal\": \"string\",\n    \"building_context\": \"string\",\n    \"study_questions\": [\"string\"],\n    \"desired_outcome\": \"string\",\n    \"setup_instructions\": \"string\"\n  },\n  \"behavior_monitoring_request_template\": {\n    \"study_id\": \"string\",\n    \"building_id\": \"string|null\",\n    \"zone_ids\": [\"string\"],\n    \"date_range\": {\n      \"start\": \"string\",\n      \"end\": \"string\"\n    },\n    \"image_selection_rules\": {\n      \"human_detected_only\": true,\n      \"dedupe_window_minutes\": 5\n    },\n    \"setup_instructions\": \"string\"\n  },\n  \"actionable_insights_request\": {\n    \"output_mode\": \"milestone_summary|final_insights\",\n    \"instructions\": \"string\"\n  }\n}"
      },
      "id": "753ca592-414d-43e6-9358-50632bd3b610",
      "name": "Setup Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        4320,
        1184
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst output = item.output ?? item.text ?? item.response ?? item.data ?? item;\nlet parsed = output;\nconst errors = [];\nif (typeof parsed === 'string') {\n  try { parsed = JSON.parse(parsed); } catch (error) { errors.push('json_parse_failed'); }\n}\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n  errors.push('payload_not_object');\n  parsed = {};\n}\nfor (const field of [\"study_plan\",\"task_graph\",\"graph_plan\",\"needfinding_request\",\"behavior_monitoring_request_template\",\"actionable_insights_request\"]) {\n  if (!(field in parsed)) errors.push('missing_' + field);\n}\nreturn [{ json: { raw_ai_output: output, parsed_output: parsed, validation_passed: errors.length === 0, validation_errors: errors } }];\n"
      },
