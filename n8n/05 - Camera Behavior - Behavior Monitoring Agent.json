      "id": "bb287178-43d7-4423-a74b-028fe100ef6d",
      "name": "Fetch Image From Proxy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst ctx = $('Prepare Monitoring Context').item.json;\nconst etag = $json.etag ?? null;\nconst imageDataUrl = $json.image_data_url ?? null;\nconst lastEtagSeen = ctx.last_etag_seen ?? null;\nconst imageChanged = etag === null || etag !== lastEtagSeen;\nconst now = new Date();\nconst studyEndTime = new Date(ctx.study_end_time);\nconst studyExpired = now >= studyEndTime;\nreturn [{\n  json: {\n    ...ctx,\n    image_data_url: imageDataUrl,\n    current_etag: etag,\n    image_changed: imageChanged,\n    study_expired: studyExpired,\n    checked_at: now.toISOString(),\n    fetch_failed: imageDataUrl === null,\n    image_id: 'snapshot_' + now.toISOString().replace(/[:.]/g, '-'),\n    timestamp: now.toISOString(),\n    zone_id: ctx.zone_ids?.[0] ?? null,\n  }\n}];\n"
      },
