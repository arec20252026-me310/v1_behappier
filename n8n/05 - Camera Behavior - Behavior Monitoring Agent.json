        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gpt-4.1-mini',\n  input: [\n    { role: 'system', content: [{ type: 'input_text', text: 'You are a building behavior monitoring agent. Analyze the image and return ONLY valid JSON with keys: detected_behaviors (array of {name, present}), confidence_scores (object), occupant_count (int or null), notes (string).' }] },\n    { role: 'user', content: [\n      { type: 'input_text', text: 'Study: ' + $json.study_id + ' Zone: ' + ($json.zone_id || 'unknown') + ' Targets: ' + JSON.stringify($json.behavior_targets) },\n      { type: 'input_image', image_url: $json.image_data_url }\n    ]}\n  ],\n  max_output_tokens: 1500\n}) }}",
