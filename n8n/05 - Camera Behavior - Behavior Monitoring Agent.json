    {
      "parameters": {
        "jsCode": "\nlet input = {};\ntry { input = $('When Executed by Orchestrator').item.json; } catch {}\nif (!input.study_id) { try { input = $('Inject Test Payload').item.json; } catch {} }\nif (!input.study_id) { try { input = $('Extract Webhook Body').item.json; } catch {} }\n\nconst studyRows = Array.isArray($input.first().json) ? $input.first().json : [$input.first().json];\nconst study = studyRows[0] ?? {};\nconst startedAt = study.started_at ? new Date(study.started_at) : new Date();\nconst durationSeconds = study.duration_seconds ?? input.duration_seconds ?? 600;\nconst studyEndTime = new Date(startedAt.getTime() + durationSeconds * 1000);\nconst inheritedEndTime = input.study_end_time ?? null;\n\nreturn [{\n  json: {\n    study_id: study.study_id ?? input.study_id,\n    building_id: study.building_id ?? input.building_id ?? null,\n    zone_ids: input.zone_ids ?? [],\n    behavior_targets: input.behavior_targets ?? [],\n    setup_instructions: input.setup_instructions ?? study.study_goal ?? '',\n    proxy_url: input.proxy_url ?? 'http://127.0.0.1:5680',\n    study_end_time: inheritedEndTime ?? studyEndTime.toISOString(),\n    last_etag_seen: input.last_etag_seen ?? null,\n    debug_mode: input.debug_mode ?? false,\n  }\n}];\n"
      },
      "id": "5e058f1c-9dcd-41d8-b1b8-44789f07de00",
      "name": "Prepare Monitoring Context",
