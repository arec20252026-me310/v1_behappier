      "parameters": {
        "jsCode": "\nlet ctx = {};\ntry { ctx = $('Parse Detection JSON').item.json; } catch {}\nif (!ctx.study_id) { try { ctx = $('Skip — Image Unchanged').item.json; } catch {} }\nif (!ctx.study_id) { try { ctx = $('Check If Image Changed').item.json; } catch {} }\nreturn [{\n  json: {\n    study_id: ctx.study_id,\n    building_id: ctx.building_id ?? null,\n    zone_ids: ctx.zone_ids ?? [],\n    behavior_targets: ctx.behavior_targets ?? [],\n    setup_instructions: ctx.setup_instructions ?? '',\n    proxy_url: ctx.proxy_url ?? 'http://127.0.0.1:5680',\n    study_end_time: ctx.study_end_time,\n    last_etag_seen: ctx.current_etag ?? ctx.last_etag_seen ?? null,\n    debug_mode: ctx.debug_mode ?? false,\n  }\n}];\n"
