      "id": "635469ab-3ef4-4922-ac23-72ef2034edc2",
      "name": "Analyze Image With Vision Model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1792,
        288
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "\nconst ctx = $('Check If Image Changed').item.json;\nconst body = $json;\nlet rawText = '';\nif (body.output && Array.isArray(body.output)) {\n  for (const block of body.output) {\n    if (block.type === 'message' && Array.isArray(block.content)) {\n      for (const c of block.content) {\n        if (c.type === 'output_text' || c.type === 'text') { rawText = c.text ?? ''; break; }\n      }\n    }\n    if (rawText) break;\n  }\n}\nif (!rawText && body.choices) rawText = body.choices?.[0]?.message?.content ?? '';\nif (!rawText) rawText = body.output_text ?? '';\nconst debugResponse = { status: body.status ?? null, error: body.error ?? null, usage: body.usage ?? null, raw_text_extracted: rawText.slice(0, 500) };\nlet parsed = {}, parseError = null;\ntry {\n  const clean = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch (e) { parseError = 'parse_failed: ' + rawText.slice(0, 200); }\nreturn [{\n  json: {\n    study_id: ctx.study_id, image_id: ctx.image_id, timestamp: ctx.timestamp, zone_id: ctx.zone_id,\n    detected_behaviors: parsed.detected_behaviors ?? [], confidence_scores: parsed.confidence_scores ?? {},\n    notes: parsed.notes ?? (parseError ? parseError : ''), model_version: 'gpt-4.1-mini',\n    parse_error: parseError, raw_api_response: debugResponse,\n    proxy_url: ctx.proxy_url, study_end_time: ctx.study_end_time,\n    behavior_targets: ctx.behavior_targets, setup_instructions: ctx.setup_instructions,\n    zone_ids: ctx.zone_ids, building_id: ctx.building_id,\n    current_etag: ctx.current_etag, debug_mode: ctx.debug_mode,\n  }\n}];\n"
      },
