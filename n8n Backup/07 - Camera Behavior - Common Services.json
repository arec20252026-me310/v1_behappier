    {
      "parameters": {
        "jsCode": "\nconst studies = Array.isArray($json) ? $json : ($json.body ?? $json.data ?? $json);\nconst rows = Array.isArray(studies) ? studies : [];\nreturn rows.map((study) => ({\n  json: {\n    study_id: study.study_id,\n    preview_status: 'preview',\n    provisional_label: 'data collection in progress',\n    metrics: {\n      latest_detection_count: 0,\n      rolling_behavior_counts: {},\n      latest_updated_at: new Date().toISOString()\n    }\n  }\n}));\n"
      },
